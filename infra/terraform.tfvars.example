# Copy to terraform.tfvars and customize.
aws_region  = "us-east-1"
aws_profile = ""

project_name = "software-factory"
environment  = "dev"

# Keep this low for the cost-minimal prototype.
log_retention_days = 1

# Leave blank on first apply. Set this after pushing the Docker image to ECR.
django_image_uri = ""

# GitHub repo allowed to deploy through Actions OIDC.
github_repository = "abhiverma31/software-factory-prototype"

# GitHub OIDC subject claims allowed to assume the deploy role.
github_oidc_subjects = [
  "repo:abhiverma31/software-factory-prototype:ref:refs/heads/main",
  "repo:abhiverma31@25632316/software-factory-prototype@1410590325:ref:refs/heads/main",
]
